{
  "name": "Arch Linux",
  "build": {
    "dockerfile": "Dockerfile-dev"
  },
  "runArgs": [
        "--env-file", "${localWorkspaceFolder}/.env"
    ], 
  "remoteUser": "vscode",
  "mounts": [
            "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
        ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
